# Flask Core Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=generate_a_secure_random_key_here

# Database Configuration
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://shms_app:replace_with_your_mysql_password@localhost:3306/shms

# Mail Settings (Optional for local development / password recovery)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=codetawde@gmail.com
MAIL_PASSWORD=replace_with_your_gmail_app_password
MAIL_DEFAULT_SENDER=codetawde@gmail.com
