/* ==========================================================================
   Agnel Polytechnic Seminar Hall Management System (SHMS)
   Official Institutional Stylesheet
   ========================================================================== */

:root {
  /* Institutional Palette - Agnel Polytechnic */
  --brand-primary: #0b2545;       /* Deep Academic Navy */
  --brand-primary-light: #134074; /* Secondary Header Blue */
  --brand-accent: #0077b6;        /* Action Blue */
  --brand-accent-hover: #023e8a;  /* Darker Action Blue */
  --brand-gold: #c59b27;          /* Emblem Gold Accent */

  /* Neutral Surface System */
  --bg-main: #f4f7fb;             /* Canvas Light Gray-Blue */
  --bg-surface: #ffffff;          /* Card & Container White */
  --bg-surface-alt: #eef4f8;      /* Table Header & Input Alt */

  /* Typography */
  --text-main: #1e293b;           /* Slate 800 Primary Text */
  --text-muted: #64748b;          /* Slate 500 Secondary Text */
  --text-inverse: #ffffff;        /* Pure White Text */

  /* Borders & Shadows */
  --border-light: #cbd5e1;
  --border-subtle: #e2e8f0;
  --border-color: #e2e8f0;        /* Unified border fallback */
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 6px -1px rgba(11, 37, 69, 0.08), 0 2px 4px -2px rgba(11, 37, 69, 0.05);
  --shadow-lg: 0 10px 15px -3px rgba(11, 37, 69, 0.1), 0 4px 6px -4px rgba(11, 37, 69, 0.05);
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 12px;

  /* Status Colors */
  --status-pending: #d97706;      /* Amber 600 */
  --status-approved: #15803d;     /* Green 700 */
  --status-rejected: #b91c1c;     /* Red 700 */
  --status-cancelled: #475569;    /* Slate 600 */
}

/* ==========================================================================
   CSS Reset & Base Rules
   ========================================================================== */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  overscroll-behavior-x: none; /* Prevents viewport horizontal rubber-banding/shaking on mobile swipe */
}

body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  background-color: var(--bg-main);
  color: var(--text-main);
  line-height: 1.6;
  min-height: 100vh;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  display: flex;
  flex-direction: column;
  overscroll-behavior-x: none;
  overflow-wrap: break-word;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

a {
  color: var(--brand-accent);
  text-decoration: none;
  transition: color 0.2s ease;
}

a:hover {
  color: var(--brand-accent-hover);
  text-decoration: underline;
}

/* Accessibility: Focus visible */
:focus-visible {
  outline: 2px solid var(--brand-accent);
  outline-offset: 2px;
}

/* Reduce motion */
@media (prefers-reduced-motion: reduce) {
  * {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}

/* ==========================================================================
   Institutional Header & Navigation
   ========================================================================== */
.site-header {
  background-color: var(--brand-primary);
  color: var(--text-inverse);
  box-shadow: var(--shadow-md);
  position: sticky;
  top: 0;
  z-index: 1000;
  width: 100%;
  max-width: 100%;
}

.top-bar {
  background-color: #07192f;
  padding: 6px 16px;
  font-size: 0.8rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  width: 100%;
  max-width: 100%;
  min-width: 0;
}

.top-bar-title {
  color: #94a3b8;
  letter-spacing: 0.5px;
  min-width: 0;
  overflow-wrap: anywhere;
}

.nav-container {
  max-width: 1280px;
  width: 100%;
  min-width: 0;
  margin: 0 auto;
  padding: 10px 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
}

.brand-wrapper {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 0;
  max-width: calc(100% - 56px);
}

.brand-logo {
  height: 52px;
  width: auto;
  object-fit: contain;
  flex-shrink: 0;
}

.brand-text {
  min-width: 0;
  overflow-wrap: break-word;
}

.brand-text h1 {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--text-inverse);
  line-height: 1.2;
  margin: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.brand-text p {
  font-size: 0.8rem;
  color: #cbd5e1;
  margin: 2px 0 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mobile-menu-toggle {
  display: none;
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: var(--text-inverse);
  font-size: 1.5rem;
  padding: 8px 12px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  min-height: 44px;
  min-width: 44px;
  flex-shrink: 0;
}

.nav-links {
  display: flex;
  align-items: center;
  list-style: none;
  gap: 18px;
}

.nav-links a {
  color: #e2e8f0;
  font-size: 0.95rem;
  font-weight: 500;
  padding: 8px 12px;
  border-radius: var(--radius-sm);
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.nav-links a:hover,
.nav-links a.active {
  background-color: rgba(255, 255, 255, 0.12);
  color: var(--text-inverse);
  text-decoration: none;
}

.badge-counter {
  background-color: var(--brand-gold);
  color: #07192f;
  font-size: 0.75rem;
  font-weight: 700;
  padding: 2px 6px;
  border-radius: 999px;
}

/* ==========================================================================
   Page Layout & Container
   ========================================================================== */
.main-wrapper {
  flex: 1;
  max-width: 1280px;
  width: 100%;
  min-width: 0;
  margin: 24px auto;
  padding: 0 20px;
  overflow-wrap: anywhere;
}

.page-header {
  margin-bottom: 24px;
  border-bottom: 2px solid var(--border-subtle);
  padding-bottom: 12px;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  flex-wrap: wrap;
  gap: 16px;
  min-width: 0;
  max-width: 100%;
}

.page-header h2 {
  font-size: 1.75rem;
  color: var(--brand-primary);
  font-weight: 700;
  overflow-wrap: break-word;
}

.page-header p {
  color: var(--text-muted);
  font-size: 0.95rem;
  overflow-wrap: break-word;
}

/* ==========================================================================
   Flash Notifications / Alerts
   ========================================================================== */
.flash-messages {
  margin-bottom: 20px;
  min-width: 0;
  max-width: 100%;
}

.alert {
  padding: 12px 16px;
  border-radius: var(--radius-md);
  margin-bottom: 10px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-left: 4px solid transparent;
  font-size: 0.95rem;
  min-width: 0;
  max-width: 100%;
  overflow-wrap: anywhere;
}

.alert-success {
  background-color: #f0fdf4;
  color: #166534;
  border-left-color: #22c55e;
}

.alert-danger {
  background-color: #fef2f2;
  color: #991b1b;
  border-left-color: #ef4444;
}

.alert-warning {
  background-color: #fffbeb;
  color: #92400e;
  border-left-color: #f59e0b;
}

.alert-info {
  background-color: #f0f9ff;
  color: #075985;
  border-left-color: #0ea5e9;
}

.alert-close {
  background: transparent;
  border: none;
  font-size: 1.25rem;
  line-height: 1;
  cursor: pointer;
  color: inherit;
  padding: 4px;
  min-height: 44px;
  min-width: 44px;
  flex-shrink: 0;
}

/* ==========================================================================
   UI Components: Cards, Grids, Badges
   ========================================================================== */
.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
  gap: 20px;
  margin-bottom: 24px;
  min-width: 0;
  max-width: 100%;
}

.card {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  padding: 20px;
  display: flex;
  flex-direction: column;
  min-width: 0;
  max-width: 100%;
}

.card:hover {
  box-shadow: var(--shadow-md);
}

.card-title {
  font-size: 1.15rem;
  color: var(--brand-primary);
  margin-bottom: 8px;
  font-weight: 600;
  overflow-wrap: break-word;
}

.stat-card {
  display: flex;
  align-items: center;
  gap: 16px;
  min-width: 0;
  max-width: 100%;
}

.stat-icon {
  width: 48px;
  height: 48px;
  border-radius: var(--radius-md);
  background-color: var(--bg-surface-alt);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  color: var(--brand-primary);
  flex-shrink: 0;
}

.stat-value {
  font-size: 1.8rem;
  font-weight: 700;
  color: var(--brand-primary);
  line-height: 1;
  overflow-wrap: anywhere;
}

.stat-label {
  font-size: 0.85rem;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-top: 4px;
  overflow-wrap: break-word;
}

/* Status Badges */
.badge {
  display: inline-block;
  padding: 4px 10px;
  border-radius: 999px;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  white-space: nowrap;
}

.badge-pending {
  background-color: #fef3c7;
  color: var(--status-pending);
}

.badge-approved {
  background-color: #dcfce7;
  color: var(--status-approved);
}

.badge-rejected {
  background-color: #fee2e2;
  color: var(--status-rejected);
}

.badge-cancelled {
  background-color: #f1f5f9;
  color: var(--status-cancelled);
}

.badge-active {
  background-color: #dbeafe;
  color: var(--brand-primary-light);
}

/* ==========================================================================
   Buttons & Form Controls
   ========================================================================== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 0.95rem;
  font-weight: 500;
  padding: 10px 18px;
  border-radius: var(--radius-sm);
  border: 1px solid transparent;
  cursor: pointer;
  min-height: 44px;
  transition: all 0.2s ease;
  text-decoration: none;
  gap: 8px;
  max-width: 100%;
  white-space: normal;
  text-align: center;
}

.btn:hover {
  text-decoration: none;
}

.btn-primary {
  background-color: var(--brand-primary);
  color: var(--text-inverse);
}

.btn-primary:hover {
  background-color: var(--brand-primary-light);
  color: var(--text-inverse);
}

.btn-accent {
  background-color: var(--brand-accent);
  color: var(--text-inverse);
}

.btn-accent:hover {
  background-color: var(--brand-accent-hover);
  color: var(--text-inverse);
}

.btn-success {
  background-color: #16a34a;
  color: var(--text-inverse);
}

.btn-success:hover {
  background-color: #15803d;
}

.btn-danger {
  background-color: #dc2626;
  color: var(--text-inverse);
}

.btn-danger:hover {
  background-color: #b91c1c;
}

.btn-outline {
  border-color: var(--border-light);
  background-color: transparent;
  color: var(--text-main);
}

.btn-outline:hover {
  background-color: var(--bg-surface-alt);
}

.btn-sm {
  padding: 6px 12px;
  font-size: 0.85rem;
  min-height: 36px;
}

/* Form Styles */
.form-container {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 24px;
  box-shadow: var(--shadow-sm);
  max-width: 680px;
  width: 100%;
  min-width: 0;
  margin: 0 auto;
}

.form-group {
  margin-bottom: 20px;
  min-width: 0;
}

.form-label {
  display: block;
  font-weight: 600;
  margin-bottom: 6px;
  font-size: 0.9rem;
  color: var(--brand-primary);
}

.form-control {
  width: 100%;
  padding: 10px 14px;
  border: 1px solid var(--border-light);
  border-radius: var(--radius-sm);
  font-size: 0.95rem;
  color: var(--text-main);
  background-color: var(--bg-surface);
  min-height: 44px;
}

.form-control:focus {
  border-color: var(--brand-accent);
  outline: none;
  box-shadow: 0 0 0 3px rgba(0, 119, 182, 0.15);
}

.form-error {
  color: #dc2626;
  font-size: 0.85rem;
  margin-top: 4px;
}

.form-check {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 16px;
  min-height: 44px;
}

.form-check input[type="checkbox"] {
  width: 20px;
  height: 20px;
  cursor: pointer;
}

/* ==========================================================================
   Data Tables
   ========================================================================== */
.table-responsive {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  overflow-x: auto;
  overscroll-behavior-x: contain;
  -webkit-overflow-scrolling: touch;
  touch-action: pan-x pan-y;
  background-color: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
}

.data-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  font-size: 0.95rem;
}

.data-table th {
  background-color: var(--bg-surface-alt);
  color: var(--brand-primary);
  font-weight: 600;
  padding: 12px 16px;
  border-bottom: 2px solid var(--border-subtle);
  white-space: nowrap;
}

.data-table td {
  padding: 12px 16px;
  border-bottom: 1px solid var(--border-subtle);
  vertical-align: middle;
}

.data-table tbody tr:hover {
  background-color: #f8fafc;
}

/* ==========================================================================
   Placeholders & Dignitary Section
   ========================================================================== */
.dignitary-card {
  text-align: center;
  padding: 20px;
  min-width: 0;
}

.portrait-placeholder {
  width: 140px;
  height: 140px;
  border-radius: 50%;
  margin: 0 auto 16px;
  background-color: #e2e8f0;
  border: 4px solid var(--brand-gold);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand-primary);
  font-weight: 700;
  font-size: 2.2rem;
  object-fit: cover;
  box-shadow: var(--shadow-md);
}

.hall-thumbnail {
  width: 100%;
  height: 190px;
  background-color: #e2e8f0;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  font-size: 1rem;
  font-weight: 500;
  margin-bottom: 12px;
  object-fit: cover;
}

/* ==========================================================================
   Pagination
   ========================================================================== */
.pagination {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  list-style: none;
  gap: 6px;
  margin-top: 24px;
}

.pagination a, .pagination span {
  padding: 8px 14px;
  border: 1px solid var(--border-light);
  border-radius: var(--radius-sm);
  color: var(--brand-primary);
  font-weight: 500;
  min-height: 44px;
  display: flex;
  align-items: center;
}

.pagination .active span {
  background-color: var(--brand-primary);
  color: var(--text-inverse);
  border-color: var(--brand-primary);
}

/* ==========================================================================
   Footer
   ========================================================================== */
.site-footer {
  background-color: var(--brand-primary);
  color: #94a3b8;
  padding: 32px 20px 16px;
  margin-top: auto;
  border-top: 4px solid var(--brand-gold);
  font-size: 0.9rem;
  width: 100%;
  max-width: 100%;
}

.footer-container {
  max-width: 1280px;
  width: 100%;
  min-width: 0;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
  gap: 24px;
  margin-bottom: 24px;
}

.footer-col {
  min-width: 0;
}

.footer-col h3 {
  color: var(--text-inverse);
  font-size: 1.05rem;
  margin-bottom: 12px;
}

.footer-bottom {
  text-align: center;
  padding-top: 16px;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  font-size: 0.8rem;
  overflow-wrap: anywhere;
}

/* ==========================================================
   SHMS Stage C.1 — Dashboard Components & Scoped Styles
   Clean, consolidated styles for Admin, Principal, & Faculty
   ========================================================== */

.eyebrow {
  margin: 0 0 8px;
  color: var(--brand-accent);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.dashboard-header-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: center;
}

.admin-stat-grid {
  margin-bottom: 28px;
}

.admin-stat-grid .stat-card {
  min-width: 0;
  gap: 16px;
  align-items: flex-start;
  border: 1px solid var(--border-subtle);
  box-shadow: 0 2px 8px rgba(11, 37, 69, 0.05);
  transition: box-shadow 0.18s ease, transform 0.18s ease;
}

.admin-stat-grid .stat-card:hover {
  box-shadow: 0 6px 18px rgba(11, 37, 69, 0.09);
  transform: translateY(-2px);
}

.admin-stat-grid .stat-value {
  margin-top: 5px;
  font-size: clamp(1.6rem, 2.5vw, 2.1rem);
  line-height: 1.2;
  overflow-wrap: anywhere;
}

.stat-description {
  margin: 6px 0 0;
  color: var(--text-muted);
  font-size: 0.8rem;
  line-height: 1.5;
}

.dashboard-section {
  margin-top: 32px;
  min-width: 0;
  max-width: 100%;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 16px;
  min-width: 0;
  max-width: 100%;
}

.section-heading h3 {
  margin: 0;
  color: var(--brand-primary);
  font-size: 1.2rem;
  overflow-wrap: break-word;
}

.section-heading p {
  margin: 5px 0 0;
  color: var(--text-muted);
  font-size: 0.9rem;
  line-height: 1.5;
  overflow-wrap: break-word;
}

.admin-action-grid {
  align-items: stretch;
}

.admin-action-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
  border: 1px solid var(--border-subtle);
  box-shadow: 0 2px 8px rgba(11, 37, 69, 0.04);
}

.admin-action-card .action-icon {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  margin-bottom: 16px;
  border: 1px solid rgba(197, 155, 39, 0.28);
  border-radius: 10px;
  background: #f8f5eb;
  color: var(--brand-primary);
  font-size: 1.35rem;
}

.admin-action-card .card-title {
  margin: 0 0 8px;
  color: var(--brand-primary);
  font-size: 1.05rem;
}

.admin-action-card p {
  flex: 1;
  margin: 0 0 20px;
  color: var(--text-muted);
  font-size: 0.9rem;
  line-height: 1.7;
}

.admin-action-card .btn {
  max-width: 100%;
}

.text-link {
  color: var(--brand-accent);
  font-size: 0.9rem;
  font-weight: 600;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  min-height: 44px;
}

.text-link:hover {
  text-decoration: underline;
}

.audit-card {
  padding: 0;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  border: 1px solid var(--border-subtle);
}

.audit-card .table-responsive {
  margin: 0;
  border: none;
  border-radius: 0;
  box-shadow: none;
}

.audit-timestamp {
  display: block;
  white-space: nowrap;
}

.audit-card td small {
  display: block;
  margin-top: 4px;
  color: var(--text-muted);
  font-size: 0.78rem;
}

.audit-details {
  min-width: 160px;
  max-width: 360px;
  overflow-wrap: anywhere;
}

.table-empty-state {
  padding: 32px 16px !important;
  text-align: center;
  color: var(--text-muted);
}

.table-empty-state > * {
  display: block;
  margin: 5px auto;
}

.table-empty-state strong {
  color: var(--brand-primary);
}

.empty-state-icon {
  font-size: 1.6rem;
}

/* ==========================================================================
   Responsive Breakpoints
   ========================================================================== */

/* Tablet & Smaller Screens (<= 768px) */
@media (max-width: 768px) {
  .top-bar {
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    padding: 8px 16px;
    font-size: 0.75rem;
  }

  .top-bar-title {
    font-size: 0.72rem;
    letter-spacing: 0.3px;
  }

  .mobile-menu-toggle {
    display: block;
  }

  .nav-links {
    display: none;
    flex-direction: column;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background-color: var(--brand-primary);
    padding: 16px 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: var(--shadow-lg);
    gap: 8px;
  }

  .nav-links.is-open {
    display: flex;
  }

  .nav-links a {
    width: 100%;
    padding: 12px;
  }

  .main-wrapper {
    margin: 16px auto;
    padding: 0 16px;
  }

  .page-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .dashboard-header-actions {
    width: 100%;
  }

  .dashboard-header-actions .btn {
    flex: 1 1 140px;
    justify-content: center;
  }

  .admin-action-card .btn {
    width: 100%;
    justify-content: center;
  }

  .audit-details {
    min-width: 140px;
  }
}

/* Mobile Phones (<= 480px, including 440px, 390px, 375px, 360px, 320px) */
@media (max-width: 480px) {
  .nav-container {
    padding: 8px 14px;
  }

  .brand-logo {
    height: 42px;
  }

  .brand-text h1 {
    font-size: 1.05rem;
  }

  .brand-text p {
    font-size: 0.72rem;
  }

  .main-wrapper {
    margin: 12px auto;
    padding: 0 12px;
  }

  .card {
    padding: 16px;
  }

  .dashboard-header-actions .btn {
    flex: 1 1 100%;
    width: 100%;
  }

  .section-heading {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .section-heading .btn,
  .section-heading .text-link {
    align-self: flex-start;
  }

  .stat-card {
    gap: 12px;
  }

  .stat-icon {
    width: 40px;
    height: 40px;
    font-size: 1.3rem;
  }

  .stat-value {
    font-size: 1.5rem;
  }
}

/* Reduced Motion preference */
@media (prefers-reduced-motion: reduce) {
  .admin-stat-grid .stat-card {
    transition: none;
  }

  .admin-stat-grid .stat-card:hover {
    transform: none;
  }
}
